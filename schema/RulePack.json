{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "issuedAt": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$",
      "type": "string"
    },
    "minAgentVersion": {
      "pattern": "^(?:0|[1-9][0-9]{0,8})\\.(?:0|[1-9][0-9]{0,8})\\.(?:0|[1-9][0-9]{0,8})$",
      "type": "string"
    },
    "packVersion": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "rules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "family": {
            "enum": [
              "fixed_pattern",
              "private_key",
              "credential_url",
              "contextual_assignment",
              "entropy"
            ],
            "type": "string"
          },
          "maxLength": {
            "maximum": 1048576,
            "minimum": 0,
            "type": "integer"
          },
          "minLength": {
            "maximum": 1048576,
            "minimum": 0,
            "type": "integer"
          },
          "pattern": {
            "maxLength": 4096,
            "type": "string"
          },
          "ruleId": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "score": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "secretType": {
            "enum": [
              "private_key",
              "provider_token",
              "access_token",
              "jwt",
              "database_credentials",
              "cloud_credential",
              "password",
              "api_key",
              "generic_secret",
              "high_entropy"
            ],
            "type": "string"
          },
          "validator": {
            "maxLength": 64,
            "pattern": "^(?:[a-z][a-z0-9_]*)?$",
            "type": "string"
          }
        },
        "required": [
          "ruleId",
          "family",
          "secretType",
          "score",
          "validator",
          "pattern",
          "minLength",
          "maxLength"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": {
      "maximum": 1000000,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "minAgentVersion",
    "packVersion",
    "issuedAt",
    "rules"
  ],
  "title": "RulePack",
  "type": "object"
}
