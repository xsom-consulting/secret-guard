{
  "name": "secret-guard-generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Générateur du Pack initial, des motifs du moteur Go et du corpus de parité de Secret Guard (outil de développement, absent du moteur livré).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "pack:initial": "node rule-pack/generate-initial-pack.ts",
    "vectors:detection": "node corpus/main.ts",
    "vectors:unicode": "node unicode-parity.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "smol-toml": "1.9.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
